# ─────────────────────────────────────────────────────────────
# Crew Orchard web: environment variables
# Copy to .env.local and fill in. Never commit real values.
# The site runs without these (forms show a "not configured" notice).
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for Stripe and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for waitlist inserts, the admin dashboard, and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys). Server only.
STRIPE_SECRET_KEY=
# Signing secret for the /api/stripe/webhook endpoint
STRIPE_WEBHOOK_SECRET=
# Recurring per-seat Price IDs (run `npm run stripe:setup` to create them)
STRIPE_PRICE_EARLY_BIRD=
STRIPE_PRICE_WAITLIST=
STRIPE_PRICE_ACADEMIC=
STRIPE_PRICE_ENTERPRISE=
# Set to "true" only after Stripe Tax is activated (Settings → Tax: head office address).
# Prices are tax-exclusive, so tax is added on top at checkout where you're registered.
STRIPE_AUTOMATIC_TAX=false
